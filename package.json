{
  "name": "mimoza-sahne",
  "productName": "Mimoza Sahne",
  "version": "1.1.0",
  "description": "Mimoza Bilişim ekran kaydı ve kurgu stüdyosu",
  "author": "Mimoza Bilişim",
  "license": "MIT",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test/export-test.mjs",
    "dist": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "uiohook-napi": "1.5.5"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "tr.com.mimozabilisim.sahne",
    "productName": "Mimoza Sahne",
    "copyright": "Mimoza Bilişim",
    "artifactName": "Mimoza-Sahne-Kurulum-${version}.${ext}",
    "npmRebuild": false,
    "publish": null,
    "files": ["src/**/*", "package.json", "node_modules/uiohook-napi/**/*", "node_modules/node-gyp-build/**/*"],
    "extraResources": [{ "from": "vendor/win", "to": "bin" }],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Mimoza Sahne",
      "runAfterFinish": true,
      "language": "1055",
      "installerLanguages": ["tr_TR"]
    }
  }
}
